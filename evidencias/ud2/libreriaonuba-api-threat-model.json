              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "cd8c1801-ad60-444e-91fc-16b7789c8867",
                  "title": "setuptools: path traversal y manejo de Unicode",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "setuptools 70.3.0 (y 79.0.1 para el CVE de Unicode). Riesgo al instalar o construir paquetes en el contenedor.\n- CVE-2025-47273 (high, CVSS 7.7, EPSS 1.539% / 74th percentile): Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal'). Corregido en 78.1.1.\n- CVE-2026-59890 (medium, CVSS 6.1, EPSS 0.405% / 33rd percentile): Improper Handling of Unicode Encoding. Corregido en 83.0.0.",
                  "mitigation": "Actualizar setuptools a >= 83.0.0 y retirar las herramientas de build de la imagen final (multi-stage build).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "b5a65166-9eeb-46a4-a0a6-2ba6c95be859",
                  "title": "jaraco-context: Zip Slip al extraer tarballs (CVE-2026-23949)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "jaraco-context 5.3.0 (dependencia de setuptools).\n- CVE-2026-23949 (high, CVSS 8.6, EPSS 0.618% / 48th percentile): sin título en el informe. Corregido en 6.1.0.",
                  "mitigation": "Actualizar jaraco-context a >= 6.1.0 o eliminar setuptools de la imagen final.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                },
                {
                  "id": "fd4e8bbb-4273-42e1-804b-a3967e2ec97e",
                  "title": "wheel: path traversal (CVE-2026-24049)",
                  "status": "Open",
